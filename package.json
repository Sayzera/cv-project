{
  "name": "cv-world",
  "version": "1.0.0",
  "private": true,
  "description": "Karakterle gezilen 3B CV dünyası (multiplayer)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 reload ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop cv-world",
    "pm2:delete": "pm2 delete cv-world",
    "pm2:logs": "pm2 logs cv-world",
    "pm2:status": "pm2 status cv-world"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pm2": "^7.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
